DATABASE_URL=jdbc:postgresql://localhost:5432/finflow
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-database-password
FINFLOW_API_KEY=replace-with-a-random-secret
JWT_SECRET=replace-with-a-base64-secret-at-least-32-bytes
ALLOWED_ORIGINS=http://localhost:3000
OPEN_FINANCE_PROVIDER=disabled

# Enable personalized generation after configuring an OpenAI model supporting Structured Outputs.
PLANNING_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSES_URI=https://api.openai.com/v1/responses
PLANNING_AI_TIMEOUT_SECONDS=60
